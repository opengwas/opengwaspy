# Copy to .env (gitignored) and fill in. Never commit the real key.
# The Data API on the host, reached from the lima VM:
OPENGWAS_URL=http://host.lima.internal:6433
# The opengwaspy developer key (an entry in ogdb-api's OGDB_DEVELOPER_KEYS):
OPENGWAS_TOKEN=
# Later, through the Gateway: OPENGWAS_URL=https://api.opengwas.io/ogdb and OPENGWAS_JWT=<OpenGWAS token>
